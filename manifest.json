{
  "manifest_version": 3,
  "name": "YouTube Music Volume Leveler",
  "version": "0.1.0",
  "description": "Auto-normalizes per-song loudness on YouTube Music, with manual per-song/per-artist overrides.",
  "permissions": ["storage"],
  "host_permissions": ["*://music.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
